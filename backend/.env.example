# Copy to .env (gitignored) and fill in to enable live integrations.
# Both are optional -- the app runs fine without either, with documented
# fallbacks (see app/explain.py and app/razorpay_client.py).

# Enables real LLM-generated explanations (app/explain.py). Without it,
# explanations fall back to a deterministic template.
ANTHROPIC_API_KEY=

# Razorpay TEST-MODE keys (Settings -> API Keys in the Razorpay dashboard,
# test mode toggle on). Enables a real payment-link API call when the
# optimizer chooses the `sms_link` intervention via an explicit
# POST /decide/{payment_id} call (app/razorpay_client.py). Without these,
# that field is simply omitted from the response.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
