# Copy to .env.local to configure the dashboard. Defaults shown below.

# Base URL of the FastAPI backend (see /backend). Only used when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:8000

# true (default) serves the bundled fixtures in src/mocks/fixtures.ts so the
# dashboard is fully navigable with no backend running. Set to false to hit
# the live API instead.
VITE_USE_MOCKS=true
